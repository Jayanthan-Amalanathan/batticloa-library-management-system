{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.js": {
      "includeFiles": "public/*.html"
    }
  },
  "redirects": [
    { "source": "/admin.html", "destination": "/admin", "permanent": true }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/api" }
  ],
  "crons": [
    { "path": "/api/cron/dlp-sync", "schedule": "0 2 1 * *" }
  ]
}
